-    bool success = false;
-    AVFrame *pic = NULL;
-    AVPacket *pkt = NULL;
-
-    const AVCodec *codec;
-    if (ctx->opts->format == AV_CODEC_ID_WEBP) {
-        codec = avcodec_find_encoder_by_name("libwebp"); // non-animated encoder
-    } else {
-        codec = avcodec_find_encoder(ctx->opts->format);
-    }
-
-    AVCodecContext *avctx = NULL;
-    if (!codec)
-        goto print_open_fail;
