-    if (ret < 0)
-        goto error_exit;
-    ret = avcodec_send_frame(avctx, NULL); // send EOF
-    if (ret < 0)
-        goto error_exit;
-    pkt = av_packet_alloc();
-    if (!pkt)
-        goto error_exit;
-    ret = avcodec_receive_packet(avctx, pkt);
-    if (ret < 0)
-        goto error_exit;
-
-    success = fwrite(pkt->data, pkt->size, 1, fp) == 1;
-
-error_exit:
-    avcodec_free_context(&avctx);
-    av_frame_free(&pic);
-    av_packet_free(&pkt);
-    return success;
-}
