-    if (avcodec_open2(avctx, codec, NULL) < 0) {
-    print_open_fail:
-        MP_ERR(ctx, "Could not open libavcodec encoder for saving images\n");
-        goto error_exit;
-    }
-
-    pic = av_frame_alloc();
-    if (!pic)
-        goto error_exit;
-    prepare_avframe(pic, avctx, image, ctx->opts->tag_csp, ctx->log);
-    if (codec->id == AV_CODEC_ID_MJPEG) {
