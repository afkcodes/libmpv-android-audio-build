diff --git a/include/mpv/client.h b/include/mpv/client.h
index 85cff63..8ab6dce 100644
--- a/include/mpv/client.h
+++ b/include/mpv/client.h
@@ -1730,6 +1730,16 @@ MPV_EXPORT mpv_event *mpv_wait_event(mpv_handle *ctx, double timeout);
  */
 MPV_EXPORT void mpv_wakeup(mpv_handle *ctx);
 
+/**
+ * Calls av_jni_set_java_vm() with the given JavaVM*.
+ * https://github.com/FFmpeg/FFmpeg/blob/master/libavcodec/jni.h
+ *
+ * The av_jni_set_java_vm() symbol is not visible when statically linking with
+ * libavcodec. It is important to call this method so that libavcodec can access
+ * the JNI environment and thus the mediacodec/AudioTrack APIs.
+ */
+MPV_EXPORT int mpv_lavc_set_java_vm(void *vm);
+
 /**
  * Set a custom function that should be called when there are new events. Use
  * this if blocking in mpv_wait_event() to wait for new events is not feasible.
diff --git a/player/client.c b/player/client.c
index e23b98b..3a1b54a 100644
--- a/player/client.c
+++ b/player/client.c
@@ -17,6 +17,8 @@
 #include <errno.h>
 #include <fcntl.h>
 #include <math.h>
+#include <libavcodec/jni.h>
+
 #include <stdatomic.h>
 #include <stddef.h>
 #include <stdint.h>
@@ -964,6 +966,11 @@ void mpv_wakeup(mpv_handle *ctx)
     mp_mutex_unlock(&ctx->lock);
 }
 
+int mpv_lavc_set_java_vm(void *vm)
+{
+    return av_jni_set_java_vm(vm, NULL);
+}
